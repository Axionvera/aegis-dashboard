# Aegis RWA Dashboard - Environment Variables Example
# Copy this file to .env.local and update the values.

# Soroban RPC Node URL (e.g., testnet or mainnet)
NEXT_PUBLIC_RPC_URL="https://soroban-testnet.stellar.org"

# Network Passphrase
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Smart Contract IDs (Whitelisting & Minting)
NEXT_PUBLIC_AEGIS_CONTRACT_ID="CABC123..."

# Mock Mode — set to "true" to use the built-in mock SDK provider instead of
# making real Soroban RPC calls. Intended for local frontend development only.
# NEVER set this to "true" in a production or testnet deployment.
NEXT_PUBLIC_MOCK_MODE="false"
